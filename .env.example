# Server-only. The Next.js routes under /api/v1 forward every request to the API Gateway,
# exchanging the httpOnly session cookie for an `Authorization: Bearer` token.
API_GATEWAY_URL=http://localhost:8080

# Optional. The Gateway has no route for /api/v1/notifications/stream yet; point this at the
# Notification Service to enable live order notifications. Leave empty once the Gateway routes it.
NOTIFICATION_SERVICE_URL=
